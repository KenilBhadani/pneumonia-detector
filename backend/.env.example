# Copy to .env (or add these in your hosting dashboard)

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pneumonia_db
# true for cloud MySQL that requires SSL (TiDB Cloud, Aiven)
DB_SSL=false

# Clerk Dashboard -> API Keys -> "Frontend API URL" (full https:// address)
CLERK_ISSUER=https://your-name-12.clerk.accounts.dev

# Websites allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary dashboard -> API environment variable. Leave empty to save images locally (dev only).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

ML_MODEL_PATH=ml_model/pneumonia_model.keras
THRESHOLD=0.5
MAX_UPLOAD_MB=10
